{
  "name": "@aduptive/strapi-block-picker",
  "version": "2.0.0-alpha.1",
  "description": "Visual component gallery for native Strapi dynamic zones.",
  "license": "MIT",
  "author": "Andrea Scarpello <aduptive@gmail.com>",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "block-picker"
  ],
  "main": "strapi-server.js",
  "files": [
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./strapi-admin": {
      "import": "./dist/admin.mjs",
      "require": "./dist/admin.cjs",
      "default": "./dist/admin.mjs"
    },
    "./strapi-server": {
      "require": "./strapi-server.js",
      "default": "./strapi-server.js"
    },
    "./package.json": "./package.json"
  },
  "strapi": {
    "name": "block-picker",
    "displayName": "Block Picker",
    "kind": "plugin",
    "description": "Independent of the frontend framework."
  },
  "engines": {
    "node": ">=20 <27"
  },
  "peerDependencies": {
    "@strapi/strapi": ">=5.23.0 <6",
    "@strapi/design-system": "^2.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^6.0.0",
    "react-intl": "^6.0.0",
    "@strapi/content-manager": ">=5.23.0 <6",
    "@strapi/admin": ">=5.23.0 <6"
  },
  "dependencies": {
    "fractional-indexing": "3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aduptive/strapi-plugin-block-picker.git",
    "directory": "packages/strapi5"
  },
  "homepage": "https://github.com/aduptive/strapi-plugin-block-picker#readme",
  "bugs": {
    "url": "https://github.com/aduptive/strapi-plugin-block-picker/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
